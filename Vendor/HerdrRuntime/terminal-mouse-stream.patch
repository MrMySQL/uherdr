+    #[tokio::test]
+    async fn direct_mouse_stream_mode_only_disable_retry_and_reconnect() {
+        let (mut server, rx, terminal_id) =
+            direct_mouse_test_server(b"hello", MouseStreamRequest::Control);
+        server.render_and_stream();
+        let mut client_terminal = crate::ghostty::Terminal::new(80, 24, 0).unwrap();
+        // An initial disabled state also clears stale modes in a reused client terminal.
+        client_terminal.write(b"\x1b[?1003h\x1b[?1016h");
+        client_terminal.write(&next_mouse_frame(&rx).bytes);
+        assert!(!client_terminal.mode_get(1003).unwrap());
+        assert!(!client_terminal.mode_get(1016).unwrap());
+
+        server
+            .runtime_for_terminal_id_string(&terminal_id)
+            .unwrap()
+            .test_process_pty_bytes(b"\x1b[?1000h\x1b[?1006h");
+        let queued =
+            HeadlessServer::frame_server_message(&ServerMessage::ReloadSoundConfig).unwrap();
+        server.clients[&1]
+            .writer
+            .as_ref()
+            .unwrap()
+            .test_fill_render(queued);
+        server.render_and_stream();
+        assert_eq!(server.clients[&1].render_state.terminal_seq(), Some(1));
+        while rx.try_recv().is_ok() {}
+        server.render_and_stream();
+        let enabled = next_mouse_frame(&rx);
+        assert_eq!(enabled.seq, 2);
+        assert!(!enabled.full);
+        client_terminal.write(&enabled.bytes);
+        assert!(client_terminal.mode_get(1000).unwrap());
+        assert!(client_terminal.mode_get(1006).unwrap());
+        let mut mouse_encoder = crate::ghostty::MouseEncoder::new().unwrap();
+        mouse_encoder.set_from_terminal(&client_terminal);
+        mouse_encoder.set_size(80, 24, 1, 1);
+        let mut event = crate::ghostty::MouseEvent::new().unwrap();
+        event.set_button(crate::ghostty::ffi::GhosttyMouseButton_GHOSTTY_MOUSE_BUTTON_LEFT);
+        event.set_position(11.0, 9.0);
+        event.set_action(crate::ghostty::ffi::GhosttyMouseAction_GHOSTTY_MOUSE_ACTION_PRESS);
+        assert_eq!(mouse_encoder.encode(&event).unwrap(), b"\x1b[<0;12;10M");
+        event.set_action(crate::ghostty::ffi::GhosttyMouseAction_GHOSTTY_MOUSE_ACTION_RELEASE);
+        assert_eq!(mouse_encoder.encode(&event).unwrap(), b"\x1b[<0;12;10m");
+        server.render_and_stream();
+        assert!(rx.try_recv().is_err());
+
+        server
+            .clients
+            .get_mut(&1)
+            .unwrap()
+            .render_state
+            .reset_baseline();
+        server.render_and_stream();
+        let reconnected = next_mouse_frame(&rx);
+        let mut fresh_terminal = crate::ghostty::Terminal::new(80, 24, 0).unwrap();
+        fresh_terminal.write(&reconnected.bytes);
+        assert!(fresh_terminal.mode_get(1000).unwrap());
+        assert!(fresh_terminal.mode_get(1006).unwrap());
+
+        server
+            .runtime_for_terminal_id_string(&terminal_id)
+            .unwrap()
+            .test_process_pty_bytes(b"\x1b[?1000l\x1b[?1006l");
+        server.render_and_stream();
+        client_terminal.write(&next_mouse_frame(&rx).bytes);
+        assert!(!client_terminal.mode_get(1000).unwrap());
+        assert!(!client_terminal.mode_get(1006).unwrap());
+    }
