+    /// Read only mouse modes and viewport position under one terminal lock.
+    pub(crate) fn direct_mouse_modes(&self) -> TerminalMouseModes {
+        let Ok(core) = self.core.lock() else {
+            return TerminalMouseModes::default();
+        };
+        // Historical cells do not correspond to the live application's mouse coordinates.
+        if core
+            .terminal
+            .scrollbar()
+            .is_ok_and(|scrollbar| scrollbar.offset + scrollbar.len < scrollbar.total)
+        {
+            return TerminalMouseModes::default();
+        }
+        TerminalMouseModes {
+            enabled: TerminalMouseModes::MODES
+                .map(|mode| core.terminal.mode_get(mode).unwrap_or(false)),
+        }
+    }
