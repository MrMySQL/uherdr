+    #[derive(Clone, Copy)]
+    enum MouseStreamRequest {
+        Attach,
+        Control,
+        Observe,
+    }
+
+    fn direct_mouse_test_server(
+        initial: &[u8],
+        request: MouseStreamRequest,
+    ) -> (HeadlessServer, std::sync::mpsc::Receiver<Vec<u8>>, String) {
+        let (mut server, rx, pane_id) = retained_test_server(initial);
+        server.app.state.ensure_test_terminals();
+        let id = server.app.state.workspaces[0]
+            .terminal_id(pane_id)
+            .unwrap()
+            .clone();
+        let runtime = server.app.state.workspaces[0]
+            .test_runtimes
+            .remove(&pane_id)
+            .unwrap();
+        server.app.terminal_runtimes.insert(id.clone(), runtime);
+        let terminal_id = id.to_string();
+        let writer = server.clients[&1].writer.as_ref().unwrap().clone();
+        assert!(server.handle_server_event(ServerEvent::ClientConnected {
+            client_id: 1,
+            cols: 80,
+            rows: 24,
+            cell_width_px: 0,
+            cell_height_px: 0,
+            render_encoding: RenderEncoding::TerminalAnsi,
+            keybindings: None,
+            direct_attach_requested: true,
+            direct_graphics: false,
+            writer,
+        }));
+        let event = match request {
+            MouseStreamRequest::Attach => ServerEvent::ClientAttachTerminal {
+                client_id: 1,
+                terminal_id: terminal_id.clone(),
+                takeover: false,
+            },
+            MouseStreamRequest::Control => ServerEvent::ClientControlTerminal {
+                client_id: 1,
+                target: terminal_id.clone(),
+                takeover: false,
+            },
+            MouseStreamRequest::Observe => ServerEvent::ClientObserveTerminal {
+                client_id: 1,
+                target: terminal_id.clone(),
+            },
+        };
+        assert!(server.handle_server_event(event));
+        (server, rx, terminal_id)
+    }
+
+    fn next_mouse_frame(rx: &std::sync::mpsc::Receiver<Vec<u8>>) -> crate::protocol::TerminalFrame {
+        match read_server_message(
+            rx.recv_timeout(Duration::from_millis(100))
+                .expect("mouse frame"),
+        ) {
+            ServerMessage::Terminal(frame) => frame,
+            other => panic!("expected terminal frame, got {other:?}"),
+        }
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn direct_mouse_stream_initial_attach_and_observe_preserve_modes() {
+        for request in [MouseStreamRequest::Control, MouseStreamRequest::Observe] {
+            for tracking in [9, 1000, 1002, 1003] {
+                for encoding in [1005, 1006, 1015, 1016] {
+                    let initial = format!("\x1b[?{tracking}h\x1b[?{encoding}hhello");
+                    let (mut server, rx, _) = direct_mouse_test_server(initial.as_bytes(), request);
+                    crate::pane::reset_aggregate_input_state_reads();
+                    server.render_and_stream();
+                    assert_eq!(crate::pane::aggregate_input_state_reads(), 0);
+                    let frame = next_mouse_frame(&rx);
+                    let mut client_terminal = crate::ghostty::Terminal::new(80, 24, 0).unwrap();
+                    client_terminal.write(&frame.bytes);
+                    assert!(
+                        client_terminal.mode_get(tracking).unwrap(),
+                        "tracking {tracking}"
+                    );
+                    assert!(
+                        client_terminal.mode_get(encoding).unwrap(),
+                        "encoding {encoding}"
+                    );
+                    assert_eq!(frame.seq, 1);
+                }
+            }
+        }
+    }
